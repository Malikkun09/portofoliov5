# Primary provider (NVIDIA Integrate API / Nemotron Omni)
# Trimmed automatically. NVAPI_KEY is an alias if NVIDIA_API_KEY is empty.
NVIDIA_API_KEY=
# NVAPI_KEY=

# Free multimodal fallback via OpenRouter.
# OpenRouter still requires a key even for :free models — there is no safe public no-key path.
# Create a free key at https://openrouter.ai/keys (no credit card for :free models).
OPENROUTER_API_KEY=

# Default free omni model: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# (text + image + video + audio). google/gemma-4-26b-a4b-it:free and openrouter/free are extra fallbacks.
# xiaomi/mimo-v2.5 is omnimodal but PAID on OpenRouter — not used by default.
# To try MiMo V2.5 anyway: OPENROUTER_MODEL=xiaomi/mimo-v2.5
# OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODELS=

# Optional metadata for OpenRouter requests
OPENROUTER_SITE_URL=https://malikfajar.me
OPENROUTER_APP_NAME=Malik Fajar Portfolio Chatbot
